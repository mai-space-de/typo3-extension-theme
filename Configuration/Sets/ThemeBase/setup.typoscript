# =============================================================================
# maispace/theme — Site Set TypoScript Setup
# =============================================================================
# This file is automatically included as TypoScript setup for every TYPO3 site
# that lists maispace/theme-base as a dependency in its site configuration.
#
# It maps site settings (configured in the TYPO3 backend under
# "Site Management > Sites > <your site> > Settings") to:
#
#   1. page.10.settings.*  — Fluid template variables accessible as {settings.*}
#   2. page.headerData.100 — Inline <style> block injecting CSS custom property
#                            overrides, so that theme colors and spacing tokens
#                            reflect the configured values without recompiling
#                            the SCSS bundle.
#
# All {$maispace.theme.*} constants below are substituted at TypoScript parse
# time with the values from the site's settings.yaml (or the defaults from
# settings.definitions.yaml when no override is set).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Fluid template settings
#    Passes site settings into Fluid templates as {settings.*}.
#    These override the hardcoded defaults in the extension's setup.typoscript.
# -----------------------------------------------------------------------------
page.10.settings {
    site {
        name    = {$maispace.theme.site.name}
        logoSrc = {$maispace.theme.site.logoSrc}
    }

    rootPageUid = {$maispace.theme.layout.rootPageUid}

    layout {
        sidebar = {$maispace.theme.layout.sidebar}
    }

    header {
        showActions = {$maispace.theme.layout.showHeaderActions}
    }

    footer {
        showNav     = {$maispace.theme.layout.showFooterNav}
        columns     = {$maispace.theme.layout.footerColumns}
    }
}

# -----------------------------------------------------------------------------
# 2. CSS custom property overrides
#    Injects an inline <style> block into <head> that re-declares the design
#    tokens defined in 01-settings/_variables.scss with values from site
#    settings.  Because the SCSS bundle uses CSS custom properties throughout,
#    any property overridden here propagates to all components automatically.
#
#    The block is injected at headerData key 100, leaving room for site
#    packages to add further overrides at higher keys (101+).
# -----------------------------------------------------------------------------
page.headerData.100 = TEXT
page.headerData.100.value (
<style>:root {
  /* Brand colors */
  --color-primary: {$maispace.theme.colors.primary};
  --color-primary-hover: {$maispace.theme.colors.primaryHover};
  --color-secondary: {$maispace.theme.colors.secondary};
  --color-secondary-hover: {$maispace.theme.colors.secondaryHover};
  --color-accent: {$maispace.theme.colors.accent};
  /* Surface and text colors */
  --color-text: {$maispace.theme.colors.text};
  --color-background: {$maispace.theme.colors.background};
  --color-surface: {$maispace.theme.colors.surface};
  --color-border: {$maispace.theme.colors.border};
  /* Typography */
  --font-family-base: {$maispace.theme.typography.fontFamilyBase};
  /* Layout tokens */
  --layout-radius: {$maispace.theme.layout.borderRadius};
  --layout-width-max: {$maispace.theme.layout.maxWidth};
  /* Button colors derived from brand palette */
  --btn-primary-bg: {$maispace.theme.colors.primary};
  --btn-primary-border: {$maispace.theme.colors.primary};
  --btn-primary-bg-hover: {$maispace.theme.colors.primaryHover};
  --btn-outline-text: {$maispace.theme.colors.primary};
  --btn-outline-border: {$maispace.theme.colors.primary};
  --btn-outline-bg-hover: {$maispace.theme.colors.primary};
  --btn-secondary-bg: {$maispace.theme.colors.secondary};
  --btn-secondary-border: {$maispace.theme.colors.secondary};
  --btn-secondary-bg-hover: {$maispace.theme.colors.secondaryHover};
  /* Link colors */
  --color-link: {$maispace.theme.colors.primary};
}</style>
)
