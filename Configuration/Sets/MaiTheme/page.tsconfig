@import 'EXT:mai_theme/Configuration/TsConfig/page/*'

# ===========================================================================
# DISABLE ALL TYPO3 CORE CONTENT ELEMENTS
# ===========================================================================

[{settings.elements.core.disableAll} == 1]
TCEFORM.tt_content.CType.removeItems := addToList(text,textpic,textmedia,image,bullets,table,uploads,multimedia,media,html,header,shortcut,list,div,menu_abstract,menu_categorized_content,menu_categorized_pages,menu_pages,menu_recently_updated,menu_related_pages,menu_section,menu_section_pages,menu_sitemap,menu_sitemap_pages,menu_subpages)
[END]

# ===========================================================================
# BASIC ELEMENTS — per-element wizard toggles
# ===========================================================================

[{settings.elements.basic.text} == 0]
mod.wizards.newContentElement.wizardItems.maispace_basic.elements.maispace_text.disabled = 1
[END]

