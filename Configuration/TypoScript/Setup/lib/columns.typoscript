lib.templates {
    columns {
        content = COA
        content {
            20 < styles.content.get
            20.select.where = colPos = 0
        }

        popovers < .content
        popovers.20.select.where = colPos = 1
        popovers.20.slide = -1

        navbar < .content
        navbar.20.select.where = colPos = 2
        navbar.20.slide = -1

        beforeContent < .content
        beforeContent.20.select.where = colPos = 3
        beforeContent.20.slide = -1

        afterContent < .content
        afterContent.20.select.where = colPos = 4
        afterContent.20.slide = -1

        footer < .content
        footer.20.select.where = colPos = 5
        footer.20.slide = -1

        hidden < .content
        hidden.20.select.where = colPos = 6
    }
}

# Smoke-test pages: lib.templates.columns.* uses styles.content.get (not page-content areas).
# Filter tt_content by smoke_ctype / smoke_plugin query param for isolated audit URLs.
[page["uid"] in [10001, 10002] && (traverse(request.getQueryParams(), "smoke_plugin") || traverse(request.getQueryParams(), "smoke_ctype"))]
lib.templates.columns.content.20.select.where.cObject = TEXT
lib.templates.columns.content.20.select.where.cObject {
    data = GP:smoke_plugin
    ifEmpty.data = GP:smoke_ctype
    wrap = colPos = 0 AND CType = '|'
    required = 1
}
[end]
