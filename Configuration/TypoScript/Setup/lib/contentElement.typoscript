    contentElement {
        settings {
            pids {
                homepage = {$pageUids.homepage}
                imprint = {$pageUids.imprint}
                dataProtectionPolicy = {$pageUids.dataProtectionPolicy}
                accessibilityStatement = {$pageUids.accessibilityStatement}
