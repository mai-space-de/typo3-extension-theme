    ## ----------------------------------------------------------------------------
    maispace_section_full < lib.contentElement
    maispace_section_full {
        templateName = SectionFull
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_50_50 < lib.contentElement
    maispace_section_50_50 {
        templateName = Section5050
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_66_33 < lib.contentElement
    maispace_section_66_33 {
        templateName = Section6633
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_33_66 < lib.contentElement
    maispace_section_33_66 {
        templateName = Section3366
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_3col < lib.contentElement
    maispace_section_3col {
        templateName = Section3Col
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_4col < lib.contentElement
    maispace_section_4col {
        templateName = Section4Col
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_sidebar_r < lib.contentElement
    maispace_section_sidebar_r {
        templateName = SectionSidebarR
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    maispace_section_sidebar_l < lib.contentElement
    maispace_section_sidebar_l {
        templateName = SectionSidebarL
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
