## ----------------------------------------------------------------------------
## WIDGETS GROUP
## Note: maispace_textmedia keeps its existing TextMedia template — the
## TCA-registered `maispace_text` now points to its own Text.html stub.
## ----------------------------------------------------------------------------
tt_content.maispace_textmedia    < lib.contentElement
tt_content.maispace_textmedia.templateName = TextMedia
tt_content.maispace_textmedia.dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
tt_content.maispace_textmedia.dataProcessing.10 {
    references.fieldName = image
    as = image
}

## Accordion / FAQ / Steps share `tx_maitheme_accordion_item`.
tt_content.maispace_accordion    < lib.contentElement
tt_content.maispace_accordion {
    templateName = Accordion
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_accordion_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
    }
}
tt_content.maispace_faq          < tt_content.maispace_accordion
tt_content.maispace_steps        < tt_content.maispace_accordion

tt_content.maispace_slider       < lib.contentElement
tt_content.maispace_slider {
    templateName = Slider
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_slider_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        dataProcessing.10 {
            references.fieldName = image
            as = images
        }
    }
}

tt_content.maispace_tabs         < lib.contentElement
tt_content.maispace_tabs {
    templateName = Tab
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_tab_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
    }
}
tt_content.maispace_tab          < tt_content.maispace_tabs

tt_content.maispace_timeline     < lib.contentElement
tt_content.maispace_timeline {
    templateName = Timeline
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_timeline_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        dataProcessing.10 {
            references.fieldName = image
            as = images
        }
    }
}

