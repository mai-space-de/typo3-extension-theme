## ------------------------------------------------------------------
## Custom CType rendering via FLUIDTEMPLATE (components in mai_theme).
## ------------------------------------------------------------------
tt_content.maispace_text = FLUIDTEMPLATE
tt_content.maispace_text {
    templateName = TextMedia
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
    layoutRootPaths.100   = EXT:mai_theme/Resources/Private/Layouts/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
    dataProcessing.10 {
        references.fieldName = image
        as = image
    }
}

tt_content.maispace_textmedia < tt_content.maispace_text
tt_content.maispace_textmedia.templateName = TextMedia

## Accordion / FAQ / Steps — shared tx_maitheme_accordion_item table.
tt_content.maispace_accordion = FLUIDTEMPLATE
tt_content.maispace_accordion {
    templateName = Accordion
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_accordion_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
    }
}

tt_content.maispace_faq < tt_content.maispace_accordion
tt_content.maispace_steps < tt_content.maispace_accordion

## Slider — tx_maitheme_slider_item table (with FilesProcessor per item).
tt_content.maispace_slider = FLUIDTEMPLATE
tt_content.maispace_slider {
    templateName = Slider
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_slider_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        dataProcessing.10 {
            references.fieldName = image
            as = images
        }
    }
}

## Tabs — tx_maitheme_tab_item table.
## NOTE: the parent CType registered in TCA is `maispace_tabs` (plural);
## the historical singular mapping is kept as an alias.
tt_content.maispace_tabs = FLUIDTEMPLATE
tt_content.maispace_tabs {
    templateName = Tab
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_tab_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
    }
}
tt_content.maispace_tab < tt_content.maispace_tabs

## Timeline — tx_maitheme_timeline_item table (with FilesProcessor per item).
tt_content.maispace_timeline = FLUIDTEMPLATE
tt_content.maispace_timeline {
    templateName = Timeline
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
    dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
    dataProcessing.10 {
        table = tx_maitheme_timeline_item
        pidInList.field = pid
        where.data = field:uid
        where.wrap = parent_uid=|
        orderBy = sort
        as = items
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        dataProcessing.10 {
            references.fieldName = image
            as = images
        }
    }
}

## Section containers (b13/container CTypes)
tt_content.maispace_section_light        = FLUIDTEMPLATE
tt_content.maispace_section_light {
    templateName = SectionContainer
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
}
tt_content.maispace_section_muted        < tt_content.maispace_section_light
tt_content.maispace_section_dark         < tt_content.maispace_section_light
tt_content.maispace_section_accent       < tt_content.maispace_section_light
tt_content.maispace_section_transparent  < tt_content.maispace_section_light
tt_content.maispace_section_sidebar_r    < tt_content.maispace_section_light
tt_content.maispace_section_sidebar_r.templateName = SectionMultiColumn
tt_content.maispace_section_sidebar_l    < tt_content.maispace_section_sidebar_r

## Bento grid
tt_content.maispace_bento = FLUIDTEMPLATE
tt_content.maispace_bento {
    templateName = BentoBox
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/
    partialRootPaths.100  = EXT:mai_theme/Resources/Private/Partials/
}

lib {
    contentElement {
        settings {
            pids {
                homepage = {$pageUids.homepage}
                imprint = {$pageUids.imprint}
                dataProtectionPolicy = {$pageUids.dataProtectionPolicy}
                accessibilityStatement = {$pageUids.accessibilityStatement}
                contact = {$pageUids.contact}
                search = {$pageUids.search}
                disclaimer = {$pageUids.disclaimer}
                newsletter = {$pageUids.newsletter}
                frontendLogin = {$pageUids.frontendLogin}
            }
        }
    }
}
