    ## ----------------------------------------------------------------------------
    ## BENTO GRID (b13/container, single colPos 200)
    ## ----------------------------------------------------------------------------
    maispace_bento < lib.contentElement
    maispace_bento {
        templateName = BentoBox
        dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
    }

    ## ============================================================================
    ## EXTBASE PLUGIN CTypes
    ##
    ## These CTypes are registered by Extbase extensions via configurePlugin()
    ## with PLUGIN_TYPE_CONTENT_ELEMENT. They must be configured as USER elements
    ## that bootstrap Extbase, NOT as FLUIDTEMPLATE content elements.
    ##
    ## Without this configuration, TYPO3 treats them as unknown CTypes and
    ## attempts to render them with FLUIDTEMPLATE, looking for templates that
    ## don't exist (Generic.html fallback).
    ## ============================================================================

    ## EXT:mai_account
    maiaccount_account = USER
    maiaccount_account {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = MaiAccount
        pluginName = Account
        vendorName = Maispace
    }
    maiaccount_mfa = USER
    maiaccount_mfa {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = MaiAccount
        pluginName = Mfa
        vendorName = Maispace
    }
    maiaccount_stories = USER
    maiaccount_stories {
        userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
        extensionName = MaiAccount
        pluginName = Stories
        vendorName = Maispace
    }
    maispace_account_account < tt_content.maiaccount_account
    maispace_account_mfa < tt_content.maiaccount_mfa
    maispace_account_stories < tt_content.maiaccount_stories

    ## EXT:mai_canteen
