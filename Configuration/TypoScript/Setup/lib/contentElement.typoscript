## ============================================================================
## lib.contentElement — shared FLUIDTEMPLATE base for every maispace_* CType.
##
## Each `tt_content.maispace_*` block copies this base via `<` and overrides
## only what differs (typically just `templateName`, occasionally a
## dataProcessing entry for inline children).
##
## The vast majority of CType blocks below are intentionally one-line stubs.
## The corresponding `Templates/ContentElements/<Name>.html` files are also
## stubs — they render `data.header` + `data.bodytext` inside a semantic
## `<section class="mai-<slug>">`. Flesh them out wave by wave per
## `PLANNED_ELEMENTS_IMPLEMENTATION.md`.
## ============================================================================

lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
    templateRootPaths.100 = EXT:mai_theme/Resources/Private/Templates/ContentElements/
    partialRootPaths.100 = EXT:mai_theme/Resources/Private/Partials/
    layoutRootPaths.100 = EXT:mai_theme/Resources/Private/Layouts/

    # Shared FAL resolution. Fields that don't exist on a given CType simply
    # yield an empty array — safe to run on every element.
    # CTypes that need a different .10 (Accordion/Slider/Tabs/Sections/Bento)
    # override it in their own block.
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = image
            as = images
        }
        11 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        11 {
            references.fieldName = assets
            as = assets
        }
        12 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        12 {
            references.fieldName = tx_maitheme_bg_image
            as = bgImage
        }
        13 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        13 {
            references.fieldName = tx_maitheme_video_poster
            as = videoPoster
        }
        14 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        14 {
            references.fieldName = tx_maitheme_image_before
            as = imageBefore
        }
        15 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        15 {
            references.fieldName = tx_maitheme_image_after
            as = imageAfter
        }
        1770716912 = record-transformation
    }

    # Shared frontend PIDs — exposed under settings for templates that need them.
    settings.pids {
        homepage = {$pageUids.homepage}
        imprint = {$pageUids.imprint}
        dataProtectionPolicy = {$pageUids.dataProtectionPolicy}
        accessibilityStatement = {$pageUids.accessibilityStatement}
        contact = {$pageUids.contact}
        search = {$pageUids.search}
        disclaimer = {$pageUids.disclaimer}
        newsletter = {$pageUids.newsletter}
        frontendLogin = {$pageUids.frontendLogin}
    }
}

## ----------------------------------------------------------------------------
## BASIC GROUP
## ----------------------------------------------------------------------------
tt_content {
    maispace_text < lib.contentElement
    maispace_text.templateName = Text
    maispace_heading < lib.contentElement
    maispace_heading.templateName = Heading
    maispace_richtext < lib.contentElement
    maispace_richtext.templateName = Richtext
    maispace_image < lib.contentElement
    maispace_image.templateName = Image
    maispace_video < lib.contentElement
    maispace_video.templateName = Video
    maispace_audio < lib.contentElement
    maispace_audio.templateName = Audio
    maispace_button < lib.contentElement
    maispace_button.templateName = Button
    maispace_linklist < lib.contentElement
    maispace_linklist.templateName = Linklist
    maispace_icon < lib.contentElement
    maispace_icon.templateName = Icon
    maispace_divider < lib.contentElement
    maispace_divider.templateName = Divider
    maispace_spacer < lib.contentElement
    maispace_spacer.templateName = Spacer
    maispace_embed < lib.contentElement
    maispace_embed.templateName = Embed
    maispace_breadcrumb < lib.contentElement
    maispace_breadcrumb {
        templateName = Breadcrumb
        dataProcessing.90 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
        dataProcessing.90 {
            special = rootline
            levels = 20
            includeNotInMenu = 1
            as = breadcrumbItems
        }
    }
    maispace_socialmedia < lib.contentElement
    maispace_socialmedia.templateName = Socialmedia
    maispace_callout < lib.contentElement
    maispace_callout.templateName = Callout
    maispace_iconlist < lib.contentElement
    maispace_iconlist.templateName = Iconlist
    maispace_textcolumns < lib.contentElement
    maispace_textcolumns.templateName = Textcolumns

    ## ----------------------------------------------------------------------------
    ## PAGE GROUP
    ## ----------------------------------------------------------------------------
    maispace_hero < lib.contentElement
    maispace_hero.templateName = Hero
    maispace_banner < lib.contentElement
    maispace_banner.templateName = Banner
    maispace_cta < lib.contentElement
    maispace_cta.templateName = Cta
    maispace_mediatext < lib.contentElement
    maispace_mediatext.templateName = Mediatext

    ## ----------------------------------------------------------------------------
    ## COMPONENTS GROUP
    ## ----------------------------------------------------------------------------
    maispace_card < lib.contentElement
    maispace_card.templateName = Card
    maispace_teaser < lib.contentElement
    maispace_teaser.templateName = Teaser
    maispace_featurebox < lib.contentElement
    maispace_featurebox.templateName = Featurebox
    maispace_profile < lib.contentElement
    maispace_profile.templateName = Profile
    maispace_testimonial < lib.contentElement
    maispace_testimonial.templateName = Testimonial
    maispace_quote < lib.contentElement
    maispace_quote.templateName = Quote
    maispace_logo < lib.contentElement
    maispace_logo.templateName = Logo
    maispace_logoshowcase < lib.contentElement
    maispace_logoshowcase.templateName = Logoshowcase
    maispace_statistic < lib.contentElement
    maispace_statistic.templateName = Statistic
    maispace_badge < lib.contentElement
    maispace_badge.templateName = Badge
    maispace_contactinfo < lib.contentElement
    maispace_contactinfo.templateName = Contactinfo

    ## ----------------------------------------------------------------------------
    ## WIDGETS GROUP
    ## ----------------------------------------------------------------------------
    maispace_textmedia < lib.contentElement
    maispace_textmedia {
        templateName = TextMedia
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        dataProcessing.10 {
            references.fieldName = image
            as = image
        }
    }

    ## Accordion / FAQ / Steps share `tx_maitheme_accordion_item`.
    maispace_accordion < lib.contentElement
    maispace_accordion {
        templateName = Accordion
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        dataProcessing.10 {
            table = tx_maitheme_accordion_item
            pidInList.field = pid
            where {
                data = field:uid
                wrap = parent_uid=|
            }
            orderBy = sort
            as = items
        }
    }
    maispace_faq < tt_content.maispace_accordion
    maispace_steps < tt_content.maispace_accordion

    maispace_slider < lib.contentElement
    maispace_slider {
        templateName = Slider
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        dataProcessing.10 {
            table = tx_maitheme_slider_item
            pidInList.field = pid
            where {
                data = field:uid
                wrap = parent_uid=|
            }
            orderBy = sort
            as = items
            dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            dataProcessing.10 {
                references.fieldName = image
                as = images
            }
        }
    }

    maispace_tabs < lib.contentElement
    maispace_tabs {
        templateName = Tab
        dataProcessing.10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        dataProcessing.10 {
            table = tx_maitheme_tab_item
            pidInList.field = pid
            where {
                data = field:uid
                wrap = parent_uid=|
            }
            orderBy = sort
            as = items
        }
    }
    maispace_tab < tt_content.maispace_tabs

    # maispace_timeline is registered by EXT:mai_timeline and rendered
    # from that extension's own TypoScript. No entry is needed here.

    maispace_modal < lib.contentElement
    maispace_modal.templateName = Modal
    maispace_beforeafter < lib.contentElement
    maispace_beforeafter.templateName = Beforeafter

    ## ----------------------------------------------------------------------------
    ## FORMS GROUP
    ## ----------------------------------------------------------------------------
    maispace_form < lib.contentElement
    maispace_form.templateName = Form
    maispace_newsletter < lib.contentElement
    maispace_newsletter.templateName = Newsletter
    maispace_map < lib.contentElement
    maispace_map.templateName = Map

    ## ----------------------------------------------------------------------------
    ## DATA GROUP
    ## ----------------------------------------------------------------------------
    maispace_table < lib.contentElement
    maispace_table.templateName = Table
    maispace_datalist < lib.contentElement
    maispace_datalist.templateName = Datalist
    maispace_gallery < lib.contentElement
    maispace_gallery.templateName = Gallery
    maispace_filelist < lib.contentElement
    maispace_filelist.templateName = Filelist
    maispace_codeblock < lib.contentElement
    maispace_codeblock.templateName = Codeblock
    maispace_chart < lib.contentElement
    maispace_chart.templateName = Chart
    maispace_progressbar < lib.contentElement
    maispace_progressbar.templateName = Progressbar
    maispace_rating < lib.contentElement
    maispace_rating.templateName = Rating

    ## ----------------------------------------------------------------------------
