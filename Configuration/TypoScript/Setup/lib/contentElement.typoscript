## ----------------------------------------------------------------------------
## SECTION CONTAINERS (b13/container)
##
## b13/container has no Fluid ViewHelper — children are exposed by
## `B13\Container\DataProcessing\ContainerProcessor`. Without an explicit
## `colPos`, it populates one Fluid variable per registered colPos as
## `children_<colPos>`. Each variant has its own template that hardcodes the
## matching column iteration.
## ----------------------------------------------------------------------------
tt_content.maispace_section_full         < lib.contentElement
tt_content.maispace_section_full {
    templateName = SectionFull
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_50_50        < lib.contentElement
tt_content.maispace_section_50_50 {
    templateName = Section5050
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_66_33        < lib.contentElement
tt_content.maispace_section_66_33 {
    templateName = Section6633
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_33_66        < lib.contentElement
tt_content.maispace_section_33_66 {
    templateName = Section3366
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_3col         < lib.contentElement
tt_content.maispace_section_3col {
    templateName = Section3Col
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_4col         < lib.contentElement
tt_content.maispace_section_4col {
    templateName = Section4Col
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_sidebar_r    < lib.contentElement
tt_content.maispace_section_sidebar_r {
    templateName = SectionSidebarR
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

tt_content.maispace_section_sidebar_l    < lib.contentElement
tt_content.maispace_section_sidebar_l {
    templateName = SectionSidebarL
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

## ----------------------------------------------------------------------------
## BENTO GRID (b13/container, single colPos 200)
## ----------------------------------------------------------------------------
tt_content.maispace_bento        < lib.contentElement
tt_content.maispace_bento {
    templateName = BentoBox
    dataProcessing.10 = B13\Container\DataProcessing\ContainerProcessor
}

## ----------------------------------------------------------------------------
## SHARED FRONTEND PIDS — exposed under settings for templates that need them.
## ----------------------------------------------------------------------------
lib.contentElement.settings.pids {
    homepage = {$pageUids.homepage}
    imprint = {$pageUids.imprint}
    dataProtectionPolicy = {$pageUids.dataProtectionPolicy}
    accessibilityStatement = {$pageUids.accessibilityStatement}
    contact = {$pageUids.contact}
    search = {$pageUids.search}
    disclaimer = {$pageUids.disclaimer}
    newsletter = {$pageUids.newsletter}
    frontendLogin = {$pageUids.frontendLogin}
}
