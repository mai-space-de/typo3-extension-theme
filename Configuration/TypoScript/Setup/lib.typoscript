@import 'EXT:mai_theme/Configuration/TypoScript/Setup/Lib/contentRecord.typoscript'
@import 'EXT:mai_theme/Configuration/TypoScript/Setup/Lib/dynamicContent.typoscript'
@import 'EXT:mai_theme/Configuration/TypoScript/Setup/Lib/columns.typoscript'
@import 'EXT:mai_theme/Configuration/TypoScript/Setup/Lib/contentElement.typoscript'

lib {
    content = CONTENT
    content {
        table = tt_content
        select {
            orderBy = sorting
            where = {#colPos} = 0
        }
    }

    sidebar = CONTENT
    sidebar {
        table = tt_content
        select {
            orderBy = sorting
            where = {#colPos} = 1
        }
    }
}
